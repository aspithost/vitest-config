{
  "name": "@abelspithost/vitest-config",
  "version": "0.0.1",
  "description": "Shared Vitest configuration preset for TypeScript projects",
  "keywords": [
    "vitest",
    "vitest-config",
    "typescript",
    "node"
  ],
  "license": "ISC",
  "author": {
    "name": "Abel Spithost",
    "url": "https://github.com/aspithost"
  },
  "homepage": "https://github.com/aspithost/vitest-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspithost/vitest-config.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run deps:check",
    "clean": "rimraf dist",
    "deps:check": "npx -y npm-check-updates --cooldown 2",
    "deps:update": "npx -y npm-check-updates -u --target minor --cooldown 2 && npm install",
    "deps:update:major": "npx -y npm-check-updates -u --cooldown 2 && npm install",
    "lint": "eslint . && npm run publint",
    "publint": "npx -y publint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "devDependencies": {
    "@abelspithost/commitlint": "^0.1.7",
    "@abelspithost/eslint-config-ts": "^2.0.0",
    "@abelspithost/tsconfig-node": "^0.1.1",
    "@commitlint/cli": "^21.2.3",
    "@types/node": "^24.13.5",
    "commitlint": "^21.2.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
